<?xml version="1.0" encoding="utf-8"?>
<!--
  Plus Jakarta Sans (SIL Open Font License), the Kin+ brand font. Declared as a
  family so android:textStyle="bold" picks the bold file automatically. The
  medium, semibold and extrabold weights are referenced directly by the text
  styles in styles.xml.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/plus_jakarta_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/plus_jakarta_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/plus_jakarta_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/plus_jakarta_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
