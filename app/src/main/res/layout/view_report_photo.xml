<?xml version="1.0" encoding="utf-8"?>
<!--
  The photo of a community report, shown in the report details dialog. The
  image is downloaded from Azure Blob Storage, so a loading line shows first.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/photoLoading"
        style="@style/Kin.Text.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/report_photo_loading" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@color/kin_stone_inset"
        android:contentDescription="@string/report_photo_description"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Kin.Medium" />
</FrameLayout>
