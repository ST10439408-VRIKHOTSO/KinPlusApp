<?xml version="1.0" encoding="utf-8"?>
<!-- Safe Journey setup (screen 10): destination, ETA, watchers, and the check in timer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Kin.Text.SemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plan_your_journey"
                android:textSize="16sp" />

            <TextView
                style="@style/Kin.Text.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/trip_section" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Kin.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- From -->
                    <LinearLayout style="@style/Widget.Kin.Row">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_location_on"
                            app:tint="@color/kin_green" />

                        <TextView
                            style="@style/Kin.Text.Muted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:text="@string/from" />

                        <TextView
                            style="@style/Kin.Text.Medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/current_location" />
                    </LinearLayout>

                    <include layout="@layout/item_divider" />

                    <!-- Destination -->
                    <LinearLayout style="@style/Widget.Kin.Row">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_flag"
                            app:tint="@color/kin_green" />

                        <TextView
                            style="@style/Kin.Text.Muted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:text="@string/destination" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="180dp"
                            android:layout_height="wrap_content">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/destinationInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/enter_destination"
                                android:inputType="textPostalAddress|textCapWords"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <include layout="@layout/item_divider" />

                    <!-- ETA -->
                    <LinearLayout style="@style/Widget.Kin.Row">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_schedule"
                            app:tint="@color/kin_green" />

                        <TextView
                            style="@style/Kin.Text.Muted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:text="@string/eta" />

                        <TextView
                            android:id="@+id/etaValue"
                            style="@style/Kin.Text.Medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="30 min" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.slider.Slider
                android:id="@+id/etaSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/eta"
                android:stepSize="5"
                android:value="30"
                android:valueFrom="5"
                android:valueTo="180" />

            <TextView
                style="@style/Kin.Text.SemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/select_watchers"
                android:textSize="16sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/circleChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <LinearLayout
                android:id="@+id/watchersGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Kin.Text.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/notify_these_people" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Kin.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/watchersContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:id="@+id/errorText"
                style="@style/Kin.Text.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startButton"
                style="@style/Widget.Kin.Button.Primary"
                android:layout_marginTop="24dp"
                android:text="@string/start_journey" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                style="@style/Kin.Text.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/checkin_section" />

            <include
                android:id="@+id/checkIn"
                layout="@layout/view_checkin_card" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
