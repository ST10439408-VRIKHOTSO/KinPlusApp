<?xml version="1.0" encoding="utf-8"?>
<!-- A journey being watched: traveller, destination, ETA and "confirm arrival". -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Kin.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/traveller"
            style="@style/Kin.Text.SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            tools:text="Sarah Miller" />

        <TextView
            android:id="@+id/destination"
            style="@style/Kin.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/kin_muted"
            tools:text="Rosebank College, Pretoria" />

        <TextView
            android:id="@+id/eta"
            style="@style/Kin.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="ETA: 2026-10-14T16:30:00Z" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/arriveButton"
            style="@style/Widget.Kin.Button.Primary"
            android:layout_marginTop="12dp"
            android:text="@string/confirm_arrival" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
