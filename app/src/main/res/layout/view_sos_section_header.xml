<?xml version="1.0" encoding="utf-8"?>
<!-- Bold section header on the SOS screen with an optional muted note on the end edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/title"
        style="@style/Kin.Text.SectionHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="Nature of incident" />

    <TextView
        android:id="@+id/trailing"
        style="@style/Kin.Text.SemiBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textColor="@color/kin_muted"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Select one"
        tools:visibility="visible" />
</LinearLayout>
