<?xml version="1.0" encoding="utf-8"?>
<!-- A member in the Circles "live member status" card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Kin.Row">

    <TextView
        android:id="@+id/initial"
        style="@style/Kin.Text.Bold"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/kin_green_container"
        android:gravity="center"
        android:textColor="@color/kin_green_on_container"
        android:textSize="17sp"
        tools:text="S" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/name"
                style="@style/Kin.Text.RowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Sarah (you)" />

            <ImageView
                android:id="@+id/meCheck"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone"
                app:tint="@color/kin_green" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_battery_std"
                app:tint="@color/kin_muted" />

            <TextView
                android:id="@+id/battery"
                style="@style/Kin.Text.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                tools:text="82%" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Kin.Text.SemiBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/kin_green_container"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="@string/status_sharing"
        android:textColor="@color/kin_green"
        android:textSize="11sp" />
</LinearLayout>
