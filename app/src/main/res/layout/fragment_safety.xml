<?xml version="1.0" encoding="utf-8"?>
<!--
  Safety hub (screen 13): safety setup score, quick actions, emergency
  contacts, the local device vault, privacy, recent activity, nearby help and
  South African emergency numbers.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <include
            android:id="@+id/topBar"
            layout="@layout/view_top_bar" />

        <!-- Safety setup score. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Kin.Card.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/kin_green" />

                            <TextView
                                style="@style/Kin.Text.SemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/security_score_label"
                                android:textColor="@color/kin_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            style="@style/Kin.Text.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/safety_setup_title" />

                        <TextView
                            android:id="@+id/setupComplete"
                            style="@style/Kin.Text.Muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="60% complete" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/scoreRing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:max="100"
                            app:indicatorColor="@color/kin_green"
                            app:indicatorSize="56dp"
                            app:trackColor="@color/kin_stone_inset"
                            app:trackThickness="5dp" />

                        <TextView
                            android:id="@+id/scoreText"
                            style="@style/Kin.Text.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textSize="13sp"
                            tools:text="60%" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Nudge: add a backup contact, or finish emergency information. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/nudgeCard"
                    style="@style/Widget.Kin.Card.Inset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/nudgeTitle"
                                style="@style/Kin.Text.SemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textSize="13sp"
                                tools:text="Add a backup contact" />

                            <TextView
                                android:id="@+id/nudgeSub"
                                style="@style/Kin.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textSize="11sp"
                                tools:text="Someone to call if your first contact can't answer" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/nudgeButton"
                            style="@style/Widget.Kin.Button.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_complete"
                            app:shapeAppearance="@style/ShapeAppearance.Kin.Small" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick actions. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <include
                android:id="@+id/quickJourney"
                layout="@layout/view_quick_tile" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/quickCheckIn"
                layout="@layout/view_quick_tile" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/quickFakeCall"
                layout="@layout/view_quick_tile" />
        </LinearLayout>

        <!-- Emergency contacts. -->
        <include
            android:id="@+id/contactsLabel"
            layout="@layout/view_section_label" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Kin.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/contactsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_group"
                        app:tint="@color/kin_muted" />

                    <TextView
                        style="@style/Kin.Text.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/no_emergency_contacts" />

                    <TextView
                        style="@style/Kin.Text.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/no_emergency_contacts_sub" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contactsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addContactButton"
            style="@style/Widget.Kin.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:text="@string/add_trusted_contact"
            android:textSize="13sp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconSize="16dp" />

        <!-- Local device vault. -->
        <include
            android:id="@+id/vaultLabel"
            layout="@layout/view_section_label" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Kin.Card.Inset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/kin_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Kin.Text.SemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vault_card_title"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/Kin.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/vault_card_body"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <include
                android:id="@+id/vaultMedical"
                layout="@layout/view_vault_tile" />

            <Space
                android:layout_width="10dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/vaultVehicle"
                layout="@layout/view_vault_tile" />
        </LinearLayout>

        <!-- Privacy controls. -->
        <include
            android:id="@+id/privacyLabel"
            layout="@layout/view_section_label" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Kin.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:id="@+id/privacyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Recent activity. -->
        <include
            android:id="@+id/activityLabel"
            layout="@layout/view_section_label" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Kin.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:id="@+id/activityContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Nearby help. -->
        <include
            android:id="@+id/nearbyLabel"
            layout="@layout/view_section_label" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Kin.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:id="@+id/nearbyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Emergency numbers. -->
        <include
            android:id="@+id/numbersLabel"
            layout="@layout/view_section_label" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Kin.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:id="@+id/numbersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
