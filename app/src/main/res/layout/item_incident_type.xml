<?xml version="1.0" encoding="utf-8"?>
<!-- One incident type tile on the SOS screen; turns soft red with a border when selected. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_incident_default"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/icon"
            style="@style/Widget.Kin.IconBadge.Danger"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="10dp"
            tools:src="@drawable/ic_medical_services" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/Kin.Text.SemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="13sp"
                tools:text="Medical" />

            <TextView
                android:id="@+id/subtitle"
                style="@style/Kin.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="10sp"
                tools:text="Injury or illness" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/check"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        app:tint="@color/kin_red" />
</FrameLayout>
