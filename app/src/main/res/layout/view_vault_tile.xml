<?xml version="1.0" encoding="utf-8"?>
<!-- A local device vault summary tile (Medical ID, Vehicle) on the Safety hub. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Kin.Card"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                app:tint="@color/kin_muted"
                tools:src="@drawable/ic_medical_services" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/label"
                style="@style/Kin.Text.SemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kin_muted"
                android:textSize="10sp"
                tools:text="MEDICAL ID" />
        </LinearLayout>

        <TextView
            android:id="@+id/line1"
            style="@style/Kin.Text.SemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="13sp"
            tools:text="Blood: O+" />

        <TextView
            android:id="@+id/line2"
            style="@style/Kin.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11sp"
            tools:text="Allergies: Penicillin" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
