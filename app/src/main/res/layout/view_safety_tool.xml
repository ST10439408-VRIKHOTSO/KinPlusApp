<?xml version="1.0" encoding="utf-8"?>
<!-- A safety tool tile on the SOS screen (siren, fake call); turns red while the tool is active. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Kin.Card"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/icon"
            style="@style/Widget.Kin.IconBadge.Danger"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="10dp"
            tools:src="@drawable/ic_campaign" />

        <TextView
            android:id="@+id/title"
            style="@style/Kin.Text.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            tools:text="Siren" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/Kin.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            tools:text="Loud alarm and flashing light" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
