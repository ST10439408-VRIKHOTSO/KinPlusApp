<?xml version="1.0" encoding="utf-8"?>
<!-- A member in Circle detail: role badge, sharing status, and a switch for your own sharing (FR-15). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Kin.Row">

    <TextView
        android:id="@+id/initial"
        style="@style/Kin.Text.Bold"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/kin_green_container"
        android:gravity="center"
        android:textColor="@color/kin_green_on_container"
        android:textSize="16sp"
        tools:text="S" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            style="@style/Kin.Text.RowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Sarah Miller" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/roleBadge"
                style="@style/Kin.Text.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="OWNER" />

            <TextView
                android:id="@+id/sharingText"
                style="@style/Kin.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                tools:text="Sharing on" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/sharingSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
