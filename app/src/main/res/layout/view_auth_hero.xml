<?xml version="1.0" encoding="utf-8"?>
<!-- Dark forest hero at the top of Login and Register: logo, headline and subtitle over the family graphic. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    android:background="@color/kin_forest">

    <za.co.kinplus.app.ui.screens.auth.AuthFamilyGraphicView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_hero_logo">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_foreground" />
            </FrameLayout>

            <TextView
                style="@style/Kin.Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="17sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/headline"
            style="@style/Kin.Text.ExtraBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.016"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/white"
            android:textSize="30sp"
            tools:text="Welcome back." />

        <TextView
            android:id="@+id/subtitle"
            style="@style/Kin.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="40dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/white_74"
            tools:text="Keep your family close and safe." />
    </LinearLayout>
</FrameLayout>
