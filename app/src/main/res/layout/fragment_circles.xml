<?xml version="1.0" encoding="utf-8"?>
<!-- Circles (screen 5): the primary circle card, live member status and other circles. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <include
            android:id="@+id/topBar"
            layout="@layout/view_top_bar" />

        <include
            android:id="@+id/offlineBanner"
            layout="@layout/view_offline_banner" />

        <!-- My Circles / Safe Zones segmented control. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/segmentCircles"
                style="@style/Kin.Segment"
                android:background="@drawable/bg_segment_selected"
                android:text="@string/my_circles"
                android:textColor="@color/kin_ink" />

            <TextView
                android:id="@+id/segmentZones"
                style="@style/Kin.Segment"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                tools:text="Safe Zones (2)" />
        </LinearLayout>

        <!-- Shown when the user belongs to at least one circle. -->
        <LinearLayout
            android:id="@+id/primaryGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/primaryCard"
                style="@style/Widget.Kin.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/primaryName"
                            style="@style/Kin.Text.Bold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="19sp"
                            tools:text="Rikhotso Family" />

                        <TextView
                            android:id="@+id/adminBadge"
                            style="@style/Kin.Text.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:text="@string/badge_admin" />

                        <ImageView
                            android:id="@+id/primaryMenu"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/delete_circle"
                            android:padding="7dp"
                            android:src="@drawable/ic_more_vert"
                            app:tint="@color/kin_muted" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/primaryStatus"
                        style="@style/Kin.Text.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        tools:text="4 members active" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/actionCode"
                            layout="@layout/view_quick_action" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="0dp" />

                        <include
                            android:id="@+id/actionAddMember"
                            layout="@layout/view_quick_action" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="0dp" />

                        <include
                            android:id="@+id/actionPermissions"
                            layout="@layout/view_quick_action" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <TextView
                    style="@style/Kin.Text.SectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_live_member_status" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/kin_green" />

                <TextView
                    style="@style/Kin.Text.SemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/label_mesh_live"
                    android:textColor="@color/kin_green"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Kin.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/membersEmpty"
                        style="@style/Kin.Text.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="@string/location_sharing_active" />

                    <LinearLayout
                        android:id="@+id/membersContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Shown when the user has no circles yet. -->
        <LinearLayout
            android:id="@+id/emptyGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                style="@style/Kin.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/empty_circles"
                android:textColor="@color/kin_muted"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/emptyCreateButton"
                style="@style/Widget.Kin.Button.Primary"
                android:layout_marginTop="20dp"
                android:text="@string/create_or_join_circle" />
        </LinearLayout>

        <!-- Other circles the user belongs to. -->
        <LinearLayout
            android:id="@+id/otherGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Kin.Text.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:text="@string/section_other_connected_circles" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Kin.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:id="@+id/otherContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createCircleButton"
            style="@style/Widget.Kin.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:text="@string/create_new_circle_cta"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconSize="18dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
