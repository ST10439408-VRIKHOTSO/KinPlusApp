<?xml version="1.0" encoding="utf-8"?>
<!-- An emergency information category with its completion bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Kin.Row"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/Kin.Text.RowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="About me" />

        <TextView
            android:id="@+id/percent"
            style="@style/Kin.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="50% complete" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            app:indicatorColor="@color/kin_green"
            app:trackColor="@color/kin_outline"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp" />
    </LinearLayout>

    <ImageView style="@style/Widget.Kin.Chevron" />
</LinearLayout>
