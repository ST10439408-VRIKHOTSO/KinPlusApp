<?xml version="1.0" encoding="utf-8"?>
<!-- A direct intervention on the SOS screen: icon, title, subtitle and an action pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/icon"
        style="@style/Widget.Kin.IconBadge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="10dp"
        tools:src="@drawable/ic_call" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/Kin.Text.SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Emergency services" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/Kin.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11sp"
            tools:text="Police, ambulance, fire" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action"
        style="@style/Widget.Kin.Button.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        app:iconPadding="5dp"
        app:iconSize="14dp"
        tools:text="Dial" />
</LinearLayout>
