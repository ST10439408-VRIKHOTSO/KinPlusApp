<?xml version="1.0" encoding="utf-8"?>
<!-- The Sign In / Sign Up segmented control at the top of the auth sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:background="@drawable/bg_segment_track"
    android:orientation="horizontal"
    android:padding="4dp">

    <TextView
        android:id="@+id/tabSignIn"
        style="@style/Kin.Segment"
        android:text="@string/tab_sign_in" />

    <TextView
        android:id="@+id/tabSignUp"
        style="@style/Kin.Segment"
        android:text="@string/tab_sign_up" />
</LinearLayout>
