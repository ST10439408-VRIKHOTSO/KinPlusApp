<?xml version="1.0" encoding="utf-8"?>
<!--
  Emergency SOS (screen 12): hold the red button for three seconds to alert
  your circles (FR-16 to FR-19), pick the nature of the incident, dial
  emergency services, and use the siren or fake call tools.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <include
            android:id="@+id/topBar"
            layout="@layout/view_top_bar" />

        <!-- Live location lock. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Kin.Card.Tinted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/kin_green" />

                    <TextView
                        style="@style/Kin.Text.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/active_signal_lock"
                        android:textColor="@color/kin_green"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/signalBody"
                    style="@style/Kin.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:textSize="13sp"
                    tools:text="Your location is locked at -25.7545, 28.2314" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The SOS button with its pulse and hold progress ring. -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp">

            <View
                android:id="@+id/pulseOuter"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/red_12" />

            <View
                android:id="@+id/pulseInner"
                android:layout_width="198dp"
                android:layout_height="198dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/red_18" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/holdProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:max="100"
                android:visibility="invisible"
                app:indicatorColor="@color/kin_red"
                app:indicatorSize="208dp"
                app:trackColor="@color/kin_red_container"
                app:trackThickness="6dp" />

            <LinearLayout
                android:id="@+id/sosButton"
                android:layout_width="184dp"
                android:layout_height="184dp"
                android:layout_gravity="center"
                android:alpha="0.85"
                android:background="@drawable/bg_sos_button"
                android:clickable="true"
                android:contentDescription="@string/sos"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_touch_app"
                    app:tint="@color/white" />

                <TextView
                    style="@style/Kin.Text.ExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.025"
                    android:text="@string/sos"
                    android:textColor="@color/white"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/holdLabel"
                    style="@style/Kin.Text.SemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white_90"
                    android:textSize="12sp"
                    tools:text="Hold 3s" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/holdInstructions"
            style="@style/Kin.Text.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textSize="15sp"
            tools:text="Hold for 3 seconds to alert your circles" />

        <TextView
            style="@style/Kin.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="@string/sos_hold_cancel_note" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/sendingProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/kin_red" />

        <TextView
            android:id="@+id/sentText"
            style="@style/Kin.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/sos_sent"
            android:textColor="@color/kin_green"
            android:visibility="gone" />

        <TextView
            android:id="@+id/queuedText"
            style="@style/Kin.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/error_offline_banner"
            android:textColor="@color/kin_red"
            android:visibility="gone" />

        <TextView
            android:id="@+id/errorText"
            style="@style/Kin.Text.Error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Nature of the incident. -->
        <include
            android:id="@+id/incidentHeader"
            layout="@layout/view_sos_section_header" />

        <LinearLayout
            android:id="@+id/incidentGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <!-- Direct interventions. -->
        <include
            android:id="@+id/interventionsHeader"
            layout="@layout/view_sos_section_header" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Kin.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/emergencyServices"
                    layout="@layout/item_intervention" />

                <include layout="@layout/item_divider" />

                <include
                    android:id="@+id/notifyFamily"
                    layout="@layout/item_intervention" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Safety tools: siren and fake call. -->
        <include
            android:id="@+id/toolsHeader"
            layout="@layout/view_sos_section_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <include
                android:id="@+id/sirenTool"
                layout="@layout/view_safety_tool" />

            <Space
                android:layout_width="10dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/fakeCallTool"
                layout="@layout/view_safety_tool" />
        </LinearLayout>

        <!-- Designated responders. -->
        <include
            android:id="@+id/respondersHeader"
            layout="@layout/view_sos_section_header" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/respondersContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Emergency protocol note. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Kin.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/kin_muted" />

                <TextView
                    android:id="@+id/protocolText"
                    style="@style/Kin.Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="4dp"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
