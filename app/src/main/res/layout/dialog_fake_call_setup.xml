<?xml version="1.0" encoding="utf-8"?>
<!-- Fake call setup: who is "calling" and how long until the phone rings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/callerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/fake_call_caller_label"
        app:counterEnabled="true"
        app:counterMaxLength="30">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/callerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="30" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/Kin.Text.SemiBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/fake_call_delay_label" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/delayChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/delayNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fake_call_now" />

        <com.google.android.material.chip.Chip
            android:id="@+id/delay10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/fake_call_10s" />

        <com.google.android.material.chip.Chip
            android:id="@+id/delay30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fake_call_30s" />

        <com.google.android.material.chip.Chip
            android:id="@+id/delay60"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fake_call_60s" />
    </com.google.android.material.chip.ChipGroup>
</LinearLayout>
