<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Shared view styles. Every layout uses these instead of one off sizes and
      colours, so all screens share the same type scale, card look and button
      shapes. Larger, high contrast type supports one handed use under stress.
    -->

    <!-- ===== Shapes ===== -->
    <style name="ShapeAppearance.Kin.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Kin.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.Kin.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ShapeAppearance.Kin.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearance.Kin.Field" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- ===== Text ===== -->
    <style name="Kin.Text" parent="">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/kin_ink</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Kin.Text.Medium">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="fontFamily">@font/plus_jakarta_sans_medium</item>
    </style>
    <style name="Kin.Text.SemiBold">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>
    <style name="Kin.Text.Bold">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
    </style>
    <style name="Kin.Text.ExtraBold">
        <item name="android:fontFamily">@font/plus_jakarta_sans_extrabold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_extrabold</item>
    </style>

    <!-- Large left aligned screen title in the top bar. -->
    <style name="Kin.Text.ScreenTitle" parent="Kin.Text.ExtraBold">
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.014</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Small grey label above a group of cards. -->
    <style name="Kin.Text.SectionLabel" parent="Kin.Text.SemiBold">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/kin_muted</item>
    </style>

    <!-- Bold header used inside the SOS screen. -->
    <style name="Kin.Text.SectionHeader" parent="Kin.Text.ExtraBold">
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">-0.012</item>
    </style>

    <style name="Kin.Text.CardTitle" parent="Kin.Text.Bold">
        <item name="android:textSize">18sp</item>
    </style>

    <!-- List row title and subtitle. -->
    <style name="Kin.Text.RowTitle" parent="Kin.Text.Medium">
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Kin.Text.RowSubtitle" parent="Kin.Text">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/kin_muted</item>
    </style>

    <style name="Kin.Text.Muted" parent="Kin.Text">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/kin_muted</item>
    </style>
    <style name="Kin.Text.Caption" parent="Kin.Text">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/kin_muted</item>
    </style>
    <style name="Kin.Text.Error" parent="Kin.Text">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/kin_red</item>
    </style>

    <!-- Tiny pill badges such as ADMIN, OWNER and P1. -->
    <style name="Kin.Text.Badge" parent="Kin.Text.Bold">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/kin_green</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <!-- Text link such as "Forgot password?". -->
    <style name="Kin.Text.Link" parent="Kin.Text.SemiBold">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/kin_green</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- ===== Cards ===== -->
    <!-- White card with a hairline border so it lifts cleanly off the stone page. -->
    <style name="Widget.Kin.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/kin_surface</item>
        <item name="strokeColor">@color/kin_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Widget.Kin.Card.Large">
        <item name="cardCornerRadius">20dp</item>
    </style>
    <!-- Inset tile one step darker than a card (stone). -->
    <style name="Widget.Kin.Card.Inset">
        <item name="cardBackgroundColor">@color/kin_stone_inset</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">14dp</item>
    </style>
    <!-- Soft evergreen banner. -->
    <style name="Widget.Kin.Card.Tinted">
        <item name="cardBackgroundColor">@color/kin_green_container</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ===== Rows ===== -->
    <style name="Widget.Kin.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- Rounded square icon badge (evergreen tint on a soft green container). -->
    <style name="Widget.Kin.IconBadge" parent="">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/bg_icon_badge</item>
        <item name="tint">@color/kin_green</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Widget.Kin.IconBadge.Danger">
        <item name="android:background">@drawable/bg_icon_badge_danger</item>
        <item name="tint">@color/kin_red</item>
    </style>

    <!-- Round 40dp icon button with a hairline border (back, filter). -->
    <style name="Widget.Kin.RoundIconButton" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_round_outlined</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="tint">@color/kin_ink</item>
    </style>

    <!-- Chevron at the end of a tappable row. -->
    <style name="Widget.Kin.Chevron" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="tint">@color/kin_muted</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Widget.Kin.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">@color/kin_outline</item>
    </style>

    <!-- ===== Buttons ===== -->
    <style name="Widget.Kin.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.Kin.Pill</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- Full width 56dp primary call to action. -->
    <style name="Widget.Kin.Button.Primary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.Kin.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Kin.Field</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/kin_green</item>
        <item name="iconTint">@color/kin_green</item>
        <item name="strokeColor">@color/kin_outline</item>
    </style>
    <style name="Widget.Kin.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- Small rounded button used inside cards ("Complete", "Check in"). -->
    <style name="Widget.Kin.Button.Small">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- ===== Inputs ===== -->
    <style name="Widget.Kin.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/kin_surface</item>
        <item name="boxStrokeColor">@color/kin_green</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/kin_green</item>
        <item name="startIconTint">@color/kin_muted</item>
        <item name="endIconTint">@color/kin_muted</item>
    </style>
    <!-- Sign in sheet field: placeholder style hint, icon at the start. -->
    <style name="Widget.Kin.TextField.Auth">
        <item name="hintEnabled">false</item>
    </style>

    <style name="Widget.Kin.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch" />

    <style name="Widget.Kin.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="chipCornerRadius">10dp</item>
    </style>

    <!-- Segmented two way control (Sign In / Sign Up, My Circles / Safe Zones). -->
    <style name="Kin.Segment" parent="Kin.Text.Bold">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/kin_muted</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Soft evergreen pill behind the selected bottom navigation tab. -->
    <style name="Widget.Kin.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/kin_green_container</item>
    </style>
</resources>
