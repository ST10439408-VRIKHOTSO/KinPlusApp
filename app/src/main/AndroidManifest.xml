<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet + connectivity for the REST API and Firebase. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location sharing and Safe Zone geofencing (FR-13, FR-21). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Background location is needed for geofences while the app is closed. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Real-time notifications (FR-30). POST_NOTIFICATIONS is required on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".KinPlusApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KinPlus"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KinPlus"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links opened from push notifications (kinplus://...) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kinplus" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging receiver for real-time safety notifications. -->
        <service
            android:name=".messaging.KinPlusMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Broadcast receiver that handles Safe Zone geofence transitions. -->
        <receiver
            android:name=".location.GeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- Default notification channel + icon for FCM. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="kinplus_safety" />

        <!-- Google Maps SDK API key (Home screen), from local.properties via the
             MAPS_API_KEY manifest placeholder set in app/build.gradle.kts. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!--
          The app provides its own WorkManager Configuration via a Hilt
          WorkerFactory (KinPlusApplication), so the default on-startup
          initializer must be removed to avoid double initialisation.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
